"guide.title" = "Start parking automatically";
"guide.subtitle" = "Set up a Shortcuts automation once, and your location is saved and shown on the Lock Screen whenever you leave the car.";
"guide.step1" = "Open the Shortcuts app and create a new automation in the Automation tab.";
"guide.step2" = "Choose the Bluetooth trigger, pick your car, and turn on \"Is Disconnected\" and \"Run Immediately\". The CarPlay trigger works too.";
"guide.step3" = "Add the \"Get Current Location\" action, then add \"Start Parking\" from Find My Car and connect its Location to Current Location.";
"guide.step4" = "Done! Parking now starts by itself when you turn off the engine, right on the Lock Screen and Dynamic Island.";
"guide.openShortcuts" = "Open Shortcuts";
"guide.siriTip" = "Ask Siri \"Where is my car in Find My Car\" to hear where you parked and open the map.";
"guide.requiresIOS17" = "Automations and Siri require iOS 17.2 or later.";
